<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base. Los colores de las pantallas los pone Compose (paleta Nexo);
         aquí solo se define lo que el sistema muestra antes de que cargue la app. -->
    <style name="Base.Theme.DesarrolloMovil" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <!-- Fondo Nexo claro: evita el destello de otro color al abrir la app -->
        <item name="android:windowBackground">@color/nexo_fondo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/nexo_fondo</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.DesarrolloMovil" parent="Base.Theme.DesarrolloMovil" />

    <color name="nexo_fondo">#F2FBFF</color>
</resources>
